# QABuddy.ai environment configuration
# Copy to .env and fill in values. Never commit .env.

# --- JIRA (Atlassian Cloud) ---
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_PAT=YOUR_JIRA_PAT
JIRA_JQL=project IN (KAN, SAM1) ORDER BY created DESC

# --- Embeddings ---
# BAAI/bge-small-en-v1.5 = 384 dims, ~130 MB, fast. bge-base = 768 dims, ~440 MB.
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Vector store ---
# Local Qdrant data directory (embedded mode, no server needed)
QDRANT_PATH=./.qabuddy/qdrant
COLLECTION_NAME=qabuddy_kb

# --- Data sources (relative to project root) ---
DATA_DIR=../data

# --- Optional LLM for answer synthesis (leave blank to run retrieval-only) ---
# Any OpenAI-compatible endpoint works (Groq, Ollama, vLLM, OpenAI, etc.)
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# --- CORS (allowed origins for the web UI, comma-separated) ---
# Use "*" for local dev; set to your Vercel URL in production, e.g.
# CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=*
